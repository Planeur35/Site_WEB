---
import Photo from './Photo.astro'
import type {NewsItem} from '../lib/sanity'
import {excerpt, formatDate, newsSlug} from '../lib/text'

interface Props {
  item: NewsItem
}
const {item} = Astro.props
---

<a
  href={`/actualites/${newsSlug(item)}`}
  class="flex items-start gap-6 border-b border-sky-900/15 px-2 py-8 transition-colors hover:bg-white/70 md:gap-8"
>
  <Photo image={item.image} class="hidden h-24 w-24 shrink-0 sm:block" width={192} sizes="96px" />
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-3">
      <time datetime={item.publishedAt} class="text-xs font-medium uppercase tracking-[0.25em] text-sky-800">{formatDate(item.publishedAt)}</time>
      {item.tag && <span class="border border-sky-500/40 px-2 py-0.5 text-xs uppercase tracking-[0.15em] text-sky-900">{item.tag}</span>}
    </div>
    <h3 class="mt-2 font-serif text-xl leading-snug text-sky-950">{item.title}</h3>
    <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-slate-600">{excerpt(item.body, 200)}</p>
  </div>
</a>
