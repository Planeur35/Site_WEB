---
import type {Settings} from '../lib/sanity'
import {NAV} from '../lib/labels'

interface Props {
  settings: Settings | null
}
const {settings} = Astro.props
---

<footer id="contact" class="mt-8 bg-nuit text-sky-100/80">
  <div class="mx-auto grid max-w-5xl gap-10 px-6 py-16 md:grid-cols-3 md:px-8">
    <div>
      <div class="flex items-center gap-3">
        <img src="/logo-icon.png" alt="" width="50" height="44" class="h-11 w-auto" />
        <span class="font-serif text-lg text-white">PIV, Planeurs d’Ille-et-Vilaine</span>
      </div>
      {settings?.tagline && <p class="mt-4 text-sm leading-relaxed">{settings.tagline}</p>}
    </div>
    <div>
      <p class="text-xs font-medium uppercase tracking-[0.3em] text-sky-300">Navigation</p>
      <ul class="mt-4 space-y-2">
        {NAV.slice(0, 5).map((n) => <li><a href={n.to} class="text-sm hover:text-white">{n.label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="text-xs font-medium uppercase tracking-[0.3em] text-sky-300">Contact</p>
      <div class="mt-4 space-y-2 text-sm leading-relaxed">
        {settings?.address && <p class="whitespace-pre-line">{settings.address}</p>}
        {settings?.contactEmail && <p><a href={`mailto:${settings.contactEmail}`} class="hover:text-white">{settings.contactEmail}</a></p>}
        {settings?.phone && <p>{settings.phone}</p>}
        <p class="flex gap-4 pt-2">
          {settings?.facebookUrl && <a href={settings.facebookUrl} rel="noopener" class="hover:text-white">Facebook</a>}
          {settings?.instagramUrl && <a href={settings.instagramUrl} rel="noopener" class="hover:text-white">Instagram</a>}
        </p>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10 py-5 text-center text-xs uppercase tracking-[0.25em] text-sky-300/80">
    © {new Date().getFullYear()} PIV · planeur35.org
  </div>
</footer>
