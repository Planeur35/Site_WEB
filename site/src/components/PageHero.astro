---
import SkyVisual from './SkyVisual.astro'
import Photo from './Photo.astro'
import Kicker from './Kicker.astro'
import {HERO_TONES} from '../lib/labels'
import type {Photo as PhotoType} from '../lib/sanity'

interface Props {
  kicker: string
  title: string
  variant?: number
  image?: PhotoType
}
const {kicker, title, variant = 0, image} = Astro.props
const tone = HERO_TONES[variant % HERO_TONES.length]
---

<div class="relative h-[52vh] min-h-[300px] overflow-hidden">
  {
    image ? (
      <Photo image={image} class="absolute inset-0" width={1600} priority />
    ) : (
      <SkyVisual from={tone.from} mid={tone.mid} to={tone.to} />
    )
  }
  <div class="absolute inset-0 bg-linear-to-t from-sky-950/55 to-transparent"></div>
  <div class="relative z-10 mx-auto flex h-full max-w-5xl flex-col justify-end px-6 pb-12 md:px-8">
    <Kicker light>{kicker}</Kicker>
    <h1 class="font-serif text-4xl leading-[1.05] tracking-tight text-white md:text-6xl">{title}</h1>
  </div>
</div>
