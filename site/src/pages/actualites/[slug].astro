---
import Layout from '../../layouts/Layout.astro'
import Photo from '../../components/Photo.astro'
import ShareButtons from '../../components/ShareButtons.astro'
import {getNews, imageUrl, type NewsItem} from '../../lib/sanity'
import {excerpt, formatDate, newsSlug, renderText} from '../../lib/text'

export async function getStaticPaths() {
  const news = await getNews()
  return news.map((item) => ({params: {slug: newsSlug(item)}, props: {item}}))
}

const {item} = Astro.props as {item: NewsItem}
const site = import.meta.env.PUBLIC_SITE_URL ?? 'https://planeur35.org'
const url = new URL(Astro.url.pathname, site).href
---

<Layout title={`${item.title} – PIV`} description={excerpt(item.body, 160)} image={imageUrl(item.image, 1200, 630)}>
  <article class="mx-auto max-w-3xl px-6 py-16 md:px-8 md:py-24">
    <a href="/actualites" class="text-xs uppercase tracking-[0.25em] text-sky-800 underline decoration-sky-300 underline-offset-4 hover:decoration-sky-800">Toutes les actualités</a>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <time datetime={item.publishedAt} class="text-xs font-medium uppercase tracking-[0.25em] text-sky-800">{formatDate(item.publishedAt)}</time>
      {item.tag && <span class="border border-sky-500/40 px-2 py-0.5 text-xs uppercase tracking-[0.15em] text-sky-900">{item.tag}</span>}
    </div>
    <h1 class="mt-3 font-serif text-4xl leading-[1.1] tracking-tight text-sky-950 md:text-5xl">{item.title}</h1>
    <Photo image={item.image} class="mt-8 aspect-[3/2] w-full" width={1200} sizes="(max-width: 768px) 100vw, 768px" priority />
    <div class="prose-piv mt-8" set:html={renderText(item.body)} />
    <ShareButtons url={url} title={item.title} class="mt-12 border-t border-sky-900/15 pt-6" />
  </article>
</Layout>
