---
import Layout from '../layouts/Layout.astro'
import PageHero from '../components/PageHero.astro'
import Section from '../components/Section.astro'
import Kicker from '../components/Kicker.astro'
import {getTariffs, getSettings} from '../lib/sanity'

const [tariffs, settings] = await Promise.all([getTariffs(), getSettings()])
const initiation = tariffs.find((t) => t.offer === 'vol-initiation')
const bookingUrl = settings?.paymentUrl ?? (settings?.contactEmail ? `mailto:${settings.contactEmail}` : '/#contact')
---

<Layout title="Venez essayer – PIV">
  <PageHero kicker="Premier vol" title="Venez essayer" variant={3} />

  <Section kicker="Vol d’initiation" title="Offrez-vous le ciel">
    <div class="grid gap-px border border-sky-900/10 bg-sky-900/10 md:grid-cols-[1.6fr_1fr]">
      <div class="bg-ciel p-8 md:p-10">
        <Kicker>Description du vol</Kicker>
        <p class="max-w-xl whitespace-pre-line leading-relaxed text-slate-700">
          {settings?.discoveryText ?? 'Le vol d’initiation est le meilleur moyen de découvrir le vol en planeur : vous volez en biplace, accompagné d’un instructeur du club.'}
        </p>
      </div>
      <div class="flex flex-col justify-between bg-ciel p-8 md:p-10">
        <div>
          <Kicker>Tarif</Kicker>
          <div class="font-serif text-4xl text-sky-950">{initiation ? `${initiation.amount} €` : '—'}</div>
          {initiation?.details && <p class="mt-2 text-sm text-slate-600">{initiation.details}</p>}
        </div>
      </div>
    </div>
  </Section>

  <Section kicker="Réservation et paiement" title="Réservez votre vol">
    <p class="max-w-xl leading-relaxed text-slate-700">
      La réservation et le paiement se font en ligne, sur la plateforme de paiement du club. Des bons de vol sont
      disponibles pour les particuliers comme pour les entreprises.
    </p>
    <p class="mt-8">
      <a
        href={bookingUrl}
        class="inline-block bg-sky-950 px-8 py-3.5 text-xs font-medium uppercase tracking-[0.3em] text-white transition-colors hover:bg-sky-800"
      >
        Réserver et payer en ligne
      </a>
    </p>
  </Section>
</Layout>
