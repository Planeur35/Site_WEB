---
import Layout from '../layouts/Layout.astro'
import PageHero from '../components/PageHero.astro'
import Section from '../components/Section.astro'
import {getTariffs, getSettings, type Tariff} from '../lib/sanity'
import {OFFER_LABELS} from '../lib/labels'

const [tariffs, settings] = await Promise.all([getTariffs(), getSettings()])
const find = (offer: string, age?: string): Tariff | undefined =>
  tariffs.find((t) => t.offer === offer && (age ? t.ageCategory === age : true))
const euros = (t?: Tariff) => (t ? `${t.amount} €` : '—')

const forfaits = ['forfait-20h', 'forfait-illimite']
const formations = ['pack-formation', 'pack-complement-formation']
---

<Layout title="S’inscrire au club – PIV">
  <PageHero kicker="Adhésion" title="S’inscrire au club" variant={2} />

  {
    tariffs.length > 0 && (
      <>
        <Section kicker="Tarifs" title="Les forfaits">
          <div class="grid gap-px border border-sky-900/10 bg-sky-900/10 md:grid-cols-2">
            {forfaits.map((offer) => (
              <div class="bg-ciel p-8 md:p-10">
                <h3 class="font-serif text-xl text-sky-950">{OFFER_LABELS[offer]}</h3>
                <dl class="mt-5 space-y-3 border-t border-sky-900/10 pt-5">
                  {[['under25', 'Moins de 25 ans'], ['over25', 'Plus de 25 ans']].map(([age, label]) => {
                    const t = find(offer, age)
                    return (
                      <div class="flex items-baseline justify-between gap-4">
                        <dt class="text-sm text-slate-700">{label}{t?.details && <span class="block text-xs text-slate-600">{t.details}</span>}</dt>
                        <dd class="font-serif text-2xl text-sky-950">{euros(t)}</dd>
                      </div>
                    )
                  })}
                </dl>
              </div>
            ))}
          </div>
        </Section>

        <Section kicker="Formation" title="Se former au pilotage">
          <div class="grid gap-px border border-sky-900/10 bg-sky-900/10 md:grid-cols-2">
            {formations.map((offer) => {
              const t = find(offer)
              return (
                <div class="bg-ciel p-8 md:p-10">
                  <div class="flex items-baseline justify-between gap-4">
                    <h3 class="font-serif text-xl text-sky-950">{OFFER_LABELS[offer]}</h3>
                    <div class="font-serif text-2xl text-sky-950">{euros(t)}</div>
                  </div>
                  {t?.details && <p class="mt-4 border-t border-sky-900/10 pt-4 text-sm text-slate-600">{t.details}</p>}
                </div>
              )
            })}
          </div>
        </Section>
      </>
    )
  }

  {
    settings?.joinText && (
      <Section kicker="Modalités" title="Comment s’inscrire">
        <p class="max-w-2xl whitespace-pre-line leading-relaxed text-slate-700">{settings.joinText}</p>
      </Section>
    )
  }

  {tariffs.length === 0 && !settings?.joinText && <Section title="Bientôt ici"><p>Les tarifs seront publiés prochainement.</p></Section>}
</Layout>
